# Backend service only. Preview uses production cookie/origin protections.
ENVIRONMENT=production
PORT=8000
AUTH_ALLOWED_ORIGINS=https://studio-suitev2-preview.up.railway.app
CORS_ORIGINS=https://studio-suitev2-preview.up.railway.app
AUTH_SESSION_SECONDS=28800
CLIENT_INVITATION_SECONDS=86400
MONGODB_APP_NAME=studio-suite-preview

# Fill privately in Railway Variables. Do not import blanks over working values.
# User selected the existing initialized studio_suite database for preview.
MONGODB_URI=
MONGODB_DB_NAME=studio_suite

# Required for live Luma testing; backend-only secret.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Enable only once private R2 storage is configured. Local storage is rejected
# in production mode; Railway's ephemeral filesystem cannot persist documents.
DOCUMENT_STORAGE_BACKEND=disabled
