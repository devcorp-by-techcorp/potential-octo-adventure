# studio-suite — web environment template
# Copy to web/.env (local) or set on the hosting service. Names only — no values.
# Vite only exposes variables prefixed with VITE_ to the client bundle.

# Base URL of the backend API service (no trailing slash). /api is appended by the client.
# Production staff auth supports HTTPS same-origin or same-site subdomains only.
# Configure AUTH_ALLOWED_ORIGINS and credentialed CORS on the backend; see docs/studio-authentication.md.
VITE_BACKEND_URL=

# Production Caddy runtime only (Railway web service variable, not VITE_*).
# Required for the Docker deployment; do not put credentials in this URL.
# Example: http://backend.railway.internal:8000
# API_UPSTREAM=
