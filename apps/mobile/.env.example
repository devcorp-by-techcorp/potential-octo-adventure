# Mobile app environment template. Copy to apps/mobile/.env for local development.
# Expo inlines EXPO_PUBLIC_* values at build time; never put secrets here.

# Backend origin. Web dev: http://localhost:8000. Native on a LAN: http://<machine-ip>:8000.
# Required on native (HTTPS only outside development); on web it defaults to the same origin.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Base for the password-reset link. Web dev: http://localhost:8081.
EXPO_PUBLIC_WEB_URL=http://localhost:8081
