{
  "name": "@illuminate/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Illuminate Studios \u2014 Studio Suite mobile app (Expo React Native, Expo Router).",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "e2e": "expo export --platform web --output-dir dist-e2e && node e2e/finance.js && node e2e/screens.js dist-e2e && node e2e/kids.js dist-e2e && node e2e/studio.js dist-e2e"
  },
  "dependencies": {
    "@expo-google-fonts/cinzel": "^0.2.3",
    "@expo-google-fonts/cormorant-garamond": "^0.2.3",
    "@expo-google-fonts/inter": "^0.2.3",
    "@expo-google-fonts/jetbrains-mono": "^0.2.3",
    "@expo/metro-runtime": "~3.2.3",
    "@is/tokens": "workspace:*",
    "expo": "~51.0.0",
    "expo-clipboard": "~6.0.3",
    "expo-constants": "~16.0.0",
    "expo-font": "~12.0.0",
    "expo-image": "~1.13.0",
    "expo-linear-gradient": "~13.0.2",
    "expo-linking": "~6.3.0",
    "expo-router": "~3.5.0",
    "expo-splash-screen": "~0.27.0",
    "expo-status-bar": "~1.12.0",
    "expo-system-ui": "~3.0.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-svg": "15.2.0",
    "react-native-web": "~0.19.10"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~18.2.0",
    "typescript": "~5.4.0"
  }
}
