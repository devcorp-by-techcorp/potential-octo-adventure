# ─────────────────────────────────────────────────────────────────────────────
# studio-suite — backend environment template
# Copy to backend/.env for local dev, or set these as service Variables on Railway.
# Names only: never commit real values. Required vars must be present or the app
# reports a clear error on first use (it still starts so health checks pass).
# ─────────────────────────────────────────────────────────────────────────────

# ---- Environment ----
# Set production explicitly for HTTPS-only staff session cookies and origin validation.
ENVIRONMENT=

# ---- Database (REQUIRED for the DB health probe) ----
# Canonical names only — no legacy aliases. Use the MongoDB Atlas/Railway driver
# connection string; percent-encode special characters in the username/password.
MONGODB_URI=
MONGODB_DB_NAME=

# ---- Database tuning (OPTIONAL — safe defaults applied when unset) ----
MONGODB_APP_NAME=
MONGODB_MAX_POOL_SIZE=
MONGODB_SERVER_SELECTION_TIMEOUT_MS=

# ---- CORS ----
# Comma-separated explicit origins (enables credentialed cross-site requests).
CORS_ORIGINS=
# Development public-flow previews only. Production credentialed CORS rejects regexes.
CORS_ORIGIN_REGEX=

# ---- Staff authentication ----
# Exact frontend origins, comma-separated. Production requires HTTPS.
# Set matching explicit CORS_ORIGINS for a separate same-site API host.
# Local default when omitted: http://localhost:5173,http://127.0.0.1:5173
AUTH_ALLOWED_ORIGINS=
# Fixed session lifetime in seconds; 60–604800, default 28800 (8 hours).
AUTH_SESSION_SECONDS=

# ---- Client invitations ----
# MongoDB must support transactions (replica set). Manual delivery only.
# Lifetime in seconds: 60–604800; default 86400 (24 hours).
CLIENT_INVITATION_SECONDS=

# ---- Cloudflare R2 (RESERVED — adapter implemented in a later task) ----
# Reserved by name only; no R2 client is wired in task 01.0.0.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_ORIGINALS=
R2_BUCKET_DERIVATIVES=

# ---- Luma / OpenAI (REQUIRED for chat; never put this key in web/.env) ----
OPENAI_API_KEY=
# Defaults to gpt-4.1-mini when omitted.
OPENAI_MODEL=

# ---- Optional studio email alerts via Resend ----
# BOOKINGS ARE STILL SAVED if email is not configured. The studio must monitor MongoDB.
RESEND_API_KEY=
BOOKING_NOTIFICATION_EMAIL=
# A verified sender on your Resend account, e.g. Studio <enquiries@your-domain>
BOOKING_FROM_EMAIL=
